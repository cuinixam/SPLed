{
  "name": "Yanga Dev Environment",
  "image": "cuinixam/yanga-dev:1.1.0",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "ms-python.python",
